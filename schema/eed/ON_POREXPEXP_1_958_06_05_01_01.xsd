									<usch:error code="0400300001" path="" value-of-select="">Не выполнено условие - Элемент ИнКонт обязателен при отсутствии Тлф и ЭлПочта.</usch:error>
								</sch:assert>
							</sch:rule>
						</sch:pattern>
					</xs:appinfo>
					<!---*************************************************************************************************************************************************************-->
