# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Хранилище сессий и счётчика номеров. Без REDIS_URL бот работает, но состояние
# живёт в памяти процесса: перезапуск — и незаконченная накладная потеряна,
# а номера накладных начнутся заново.
REDIS_URL=redis://localhost:6379/0
ETRN_SESSION_TTL=43200

# Профили организаций-грузоотправителей (заводятся командой /orgs).
ETRN_ORGS_FILE=var/orgs.json

# ── РАСПОЗНАВАНИЕ ───────────────────────────────────────────────────────────
# Основной путь: Yandex Vision OCR. У него есть готовые модели под наши
# документы (паспорт, права, СТС, автономера), которые возвращают не текст,
# а именованные поля. Данные остаются в российском облаке.
# Нужен сервисный аккаунт с ролью ai.vision.user и его API-ключ.
ETRN_YANDEX_API_KEY=
ETRN_YANDEX_FOLDER_ID=

# Запасной путь: локальный tesseract. Печатные заявки и вордовские карточки
# читает отлично, бланки с защитной сеткой — плохо. Работает без настройки.
ETRN_OCR_LANGS=rus+eng
ETRN_OCR_TIMEOUT=60
ETRN_OCR_DPI=300          # чем разворачивать PDF; ниже 200 читается плохо
ETRN_OCR_PSM=6            # сегментация «единый блок текста» — для бланков

# Языковая модель нужна там, где OCR слаб: фото ВУ, рукописные правки, мятые
# сканы. Заполнять только если такой провайдер выбран.
# ВНИМАНИЕ: через провайдера уходят фото водительских удостоверений, то есть
# персональные данные. При зарубежном сервисе это трансграничная передача ПД.
ETRN_VLM_BASE_URL=
ETRN_VLM_API_KEY=
ETRN_VLM_MODEL=
ETRN_VLM_TIMEOUT=900

# ocr — распознаём текст, реквизиты достаёт наш разбор (по умолчанию);
# json — сильная модель сама возвращает реквизиты по схеме из реестра.
ETRN_VLM_MODE=ocr

# Сколько бот ждёт распознавание, прежде чем сказать, что не дождался.
# Пачка PDF-сканов читается минутами — не ставьте меньше 300.
ETRN_EXTRACT_TIMEOUT=600
