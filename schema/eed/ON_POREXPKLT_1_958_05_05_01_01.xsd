										</xs:simpleType>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
							<xs:element name="ПодпИнфКлнт" type="ПодписантТип">
								<xs:annotation>
									<!---************************************************************************************************************************************************************-->
									<xs:appinfo>
										<sch:pattern name="Проверка присутствия элемента СвДоверЭл">
											<sch:rule context="ПодпИнфКлнт">
												<sch:assert test="usch:iif(@СпосПодтПолном=3, count(СвДоверЭл)!=0, count(СвДоверЭл)=0)">
													<usch:error code="0400300003" path="" value-of-select="">Не выполнено условие: Элемент СвДоверЭл обязателен и формируется только при значении элемента СпосПодтПолном, равном "3".</usch:error>
