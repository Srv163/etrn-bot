												<xs:documentation>Сведения о клиенте</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="СвЭксп" type="УчастникТип">
											<xs:annotation>
												<xs:documentation>Сведения об экспедиторе</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="СвГО" type="УчастникТип">
											<xs:annotation>
												<xs:documentation>Сведения о грузоотправителе</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ДогТрЭксп" type="РеквДокТип">
											<xs:annotation>
												<xs:documentation>Реквизиты договора транспортной экспедиции</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="СопрДок" type="РеквДокТип" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Сведения о сопроводительных документах на груз</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ВладИнфр" minOccurs="0">
											<xs:annotation>
												<!---************************************************************************************************************************************************************-->
												<xs:appinfo>
													<sch:pattern name="Проверка присутствия элемента ОбНетИнфОВлад">
														<sch:rule context="ВладИнфр">
															<sch:assert test="usch:iif(@СовпГОВ=3, count(@ОбНетИнфОВлад)!=0, count(@ОбНетИнфОВлад)!=0 or count(@ОбНетИнфОВлад)=0)">
																<usch:error code="0400300003">Не выполнено условие - Элемент ОбНетИнфОВлад обязателен при значении элемента СовпГОВ=3 </usch:error>
															</sch:assert>
														</sch:rule>
													</sch:pattern>
												</xs:appinfo>
												<!---*************************************************************************************************************************************************************-->
												<!---************************************************************************************************************************************************************-->
												<xs:appinfo>
													<sch:pattern name="Проверка присутствия элемента РекВладИнф">
														<sch:rule context="ВладИнфр">
															<sch:assert test="usch:iif(@СовпГОВ=2, count(РекВладИнф)!=0, count(РекВладИнф)!=0 or count(РекВладИнф)=0)">
																<usch:error code="0400300003">Не выполнено условие - Элемент РекВладИнф обязателен при значении элемента СовпГОВ=2 </usch:error>
															</sch:assert>
														</sch:rule>
													</sch:pattern>
												</xs:appinfo>
												<!---*************************************************************************************************************************************************************-->
												<xs:documentation>Сведения о владельце объекта инфраструктуры пункта погрузки</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="РекВладИнф" type="УчастникТип" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Реквизиты владельца объекта инфраструктуры пункта погрузки</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="СовпГОВ" use="required">
													<xs:annotation>
														<xs:documentation>Признак совпадения лица, которое является владельцем инфраструктуры пункта погрузки, с грузоотправителем</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:length value="1"/>
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												<xs:attribute name="ОбНетИнфОВлад" use="optional">
													<xs:annotation>
														<xs:documentation>Обстоятельства, являющиеся причиной отсутствия информации о владельце инфраструктуры пункта погрузки</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:minLength value="1"/>
															<xs:maxLength value="1000"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="СвЛицПриемГр" type="УчастникТип" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Сведения о лице, осуществляющем прием груза во владение от имени экспедитора</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ОснДовПриемГр" type="РеквДокТип" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Основание, по которому экономический субъект является лицом, осуществляющим прием груза во владение от имени экспедитора</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="СвЛицПогрГр" minOccurs="0">
											<xs:annotation>
												<!---************************************************************************************************************************************************************-->
												<xs:appinfo>
													<sch:pattern name="Проверка присутствия элемента РеквДокЛицо">
														<sch:rule context="СвЛицПогрГр">
															<sch:assert test="usch:iif(@ЛицоПогруз=2, count(РеквДокЛицо)!=0, count(РеквДокЛицо)!=0 or count(РеквДокЛицо)=0)">
																<usch:error code="0400300003">Не выполнено условие - Элемент РеквДокЛицо обязателен при значении элемента ЛицоПогруз=2 </usch:error>
															</sch:assert>
														</sch:rule>
													</sch:pattern>
												</xs:appinfo>
												<!---*************************************************************************************************************************************************************-->
												<xs:documentation>Сведения о лице, производящем погрузку груза</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="РеквДокЛицо" type="РеквДокТип" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Реквизиты документа, подтверждающего полномочия лица, производящего погрузку груза, на проведение указанных действий</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="ЛицоПогруз" use="required">
													<xs:annotation>
														<xs:documentation>Лицо, производящее погрузку груза</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:length value="1"/>
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="ИспрФО" type="ИспрТип" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Исправление файла обмена информации экспедитора</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="ИнфПол" type="ИнфПолТип" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Информационное поле</xs:documentation>
											</xs:annotation>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="УИД_ЭкспР" use="optional">
										<xs:annotation>
											<xs:documentation>Уникальный идентификатор документа (УИД) электронной экспедиторской расписки</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:length value="36"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="СодОпер" use="required">
										<xs:annotation>
											<xs:documentation>Содержание операции</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:length value="36"/>
												<xs:enumeration value="груз принят во владение экспедитором"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="ИдИсхФайл" use="optional">
										<xs:annotation>
											<xs:documentation>Идентификатор исходного файла обмена информации экспедитора, в который вносится исправление</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="255"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="УИД_ПредЭкспР" use="optional">
										<xs:annotation>
											<xs:documentation>УИД предыдущей электронной экспедиторской расписки, вместо которой сформирована данная электронная экспедиторская расписка</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:length value="36"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="НомДок" use="required">
										<xs:annotation>
											<xs:documentation>Номер экспедиторской расписки</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="1000"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="ДатаДок" type="ДатаТип" use="required">
										<xs:annotation>
											<xs:documentation>Дата выдачи экспедиторской расписки</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="НомРеестр" use="required">
										<xs:annotation>
											<xs:documentation>Регистрационный номер записи в реестре уведомлений о транспортно-экспедиционной деятельности</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="50"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="ДатаРеестр" type="ДатаТип" use="required">
										<xs:annotation>
											<xs:documentation>Дата записи в реестре уведомлений о транспортно-экспедиционной деятельности</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="УИД_ПорЭксп" use="required">
										<xs:annotation>
											<xs:documentation>Уникальный идентификатор документа (УИД) электронного поручения экспедитору</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:length value="36"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="ФДатПол" type="ДатаТип" use="required">
										<xs:annotation>
											<xs:documentation>Фактическая дата получения груза экспедитором</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="ФВрПол" type="ВремяТип" use="optional">
										<xs:annotation>
											<xs:documentation>Фактическое время получения груза экспедитором</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="КолМестГрВсего" use="optional">
										<xs:annotation>
											<xs:documentation>Общее количество грузовых мест</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:integer">
												<xs:totalDigits value="12"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="ВозмУкОбщСтГруз" use="required">
										<xs:annotation>
											<xs:documentation>Возможность указания общей стоимости груза</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:length value="1"/>
												<xs:enumeration value="0"/>
												<xs:enumeration value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
							<xs:element name="ПодпИнфЭксп" type="ПодписантТип">
								<xs:annotation>
									<!---************************************************************************************************************************************************************-->
									<xs:appinfo>
										<sch:pattern name="Проверка присутствия элемента СвДоверЭл">
											<sch:rule context="ПодпИнфЭксп">
