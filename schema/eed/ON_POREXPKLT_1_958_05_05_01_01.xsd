				<xs:restriction base="xs:string">
					<xs:minLength value="15"/>
					<xs:maxLength value="17"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="Долгота" use="required">
			<xs:annotation>
				<xs:documentation>Долгота</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
