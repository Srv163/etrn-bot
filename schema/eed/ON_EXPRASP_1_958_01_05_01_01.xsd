																		</sch:assert>
																	</sch:rule>
																</sch:pattern>
															</xs:appinfo>
															<!---*************************************************************************************************************************************************************-->
															<xs:documentation>Сведения о контейнере</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="НомПломб" minOccurs="0" maxOccurs="unbounded">
