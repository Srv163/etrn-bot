											<sch:assert test="usch:iif(count(@ИныеСвед)=0 and count(@ИННФЛ)=0, count(ФИО)!=0, count(ФИО)!=0 or count(ФИО)=0)">
												<usch:error code="0400300001">Не выполнено условие - Элемент СвФЛУч/ФИО обязателен при отсутствии СвФЛУч/ИННФЛ и СвФЛУч/ИныеСвед.</usch:error>
											</sch:assert>
										</sch:rule>
									</sch:pattern>
								</xs:appinfo>
								<!---*************************************************************************************************************************************************************-->
								<!---************************************************************************************************************************************************************-->
								<xs:appinfo>
									<sch:pattern name="Проверка присутствия элемента ИныеСвед">
