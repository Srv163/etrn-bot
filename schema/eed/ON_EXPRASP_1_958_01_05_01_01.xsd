																		<xs:enumeration value="2"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="СумВесГруз" use="optional">
																<xs:annotation>
																	<xs:documentation>Суммарный вес всех грузов в контейнере, брутто (кг)</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:decimal">
																		<xs:totalDigits value="18"/>
																		<xs:fractionDigits value="4"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ВесТара" use="optional">
