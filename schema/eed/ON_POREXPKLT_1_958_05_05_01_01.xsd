<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2011 sp1 (http://www.altova.com) by Shakeev (FGUP GNIVC FNS Russia) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:usch="http://www.unisoftware.ru/schematron-extensions" xmlns:sql="urn:schemas-microsoft-com:mapping-schema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="Файл">
		<xs:annotation>
			<!---**************************************************************************************************************************************************************************-->
			<xs:appinfo>
				<sch:pattern name="Проверка имени файла на соответствие значению атрибута @ИдФайл">
					<sch:rule context="Файл">
						<!-- 1. Проверка имени файла на соответствие ИдФайл -->
						<sch:assert test="usch:getFileName() = @ИдФайл">
							<usch:error code="0400400007" path="@ИдФайл" value-of-select="@ИдФайл" doc-id-path="usch:getFileName()" doc-id-caption="Файл">Имя файла обмена "<usch:value-of select="usch:getFileName()"/>" не совпадает со значением элемента ИдФайл "<usch:value-of select="@ИдФайл"/>"</usch:error>
						</sch:assert>
					</sch:rule>
				</sch:pattern>
			</xs:appinfo>
			<!---**************************************************************************************************************************************************************************-->
			<xs:documentation>Файл обмена</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ИдПолИной" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Идентификатор иного получателя файла обмена информации клиента</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="4"/>
							<xs:maxLength value="46"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Документ">
					<xs:annotation>
						<xs:documentation>Электронное поручение экспедитору, информация клиента</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ОснДовОргСост" type="РеквДокТип" minOccurs="0">
								<xs:annotation>
									<!---************************************************************************************************************************************************************-->
									<xs:appinfo>
										<sch:pattern name="Проверка присутствия элемента ОснДовОргСост">
											<sch:rule context="Документ">
												<sch:assert test="usch:iif(count(@НаимЭкСубСост)!=0, count(ОснДовОргСост)!=0, count(ОснДовОргСост)!=0 or count(ОснДовОргСост)=0)">
													<usch:error code="0400300001">Не выполнено условие - Элемент ОснДовОргСост обязателен при наличии элемента НаимЭкСубСост.</usch:error>
												</sch:assert>
											</sch:rule>
										</sch:pattern>
									</xs:appinfo>
									<!---*************************************************************************************************************************************************************-->
									<xs:documentation>Основание, по которому экономический субъект является составителем файла обмена информации клиента</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="СодИнфКлнт">
								<xs:annotation>
									<xs:documentation>Содержание электронного поручения экспедитору, информация клиента</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:choice>
											<xs:element name="ОбщОбъявлСтГруз" type="СтГрузТип" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Общая объявленная стоимость груза</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element name="ОбщДейстСтГруз" type="СтГрузТип" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Общая действительная стоимость груза</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:choice>
										<xs:element name="ИныеДанКлнт" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Иные данные и оговорки клиента</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="2000"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="СвГруз" maxOccurs="unbounded">
											<xs:annotation>
												<!---** Условие ****************************************************************************************************************************************-->
												<xs:appinfo>
													<sch:pattern name="Проверка присутствие элемента СвКонтейн">
														<sch:rule context="СвГруз">
															<sch:assert test="usch:iif( 
												@ПрзПрвз=1 or @ПрзПрвз=2 , 
												count(СвКонтейн)!=0 , 
												count(СвКонтейн)=0
												)">
																<usch:error code="0400300003" path="СвКонтейн" value-of-select="count(СвКонтейн)">Не выполнено условие - Элемент СвКонтейн обязателен и формируется только при значении элемента ПрзПрвз, равном "1" или "2".</usch:error>
															</sch:assert>
														</sch:rule>
													</sch:pattern>
												</xs:appinfo>
												<!---***************************************************************************************************************************************************-->
												<xs:documentation>Сведения о грузе, готовом к отправке</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="СвУведСторон" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<!---************************************************************************************************************************************************************-->
															<xs:appinfo>
																<sch:pattern name="Проверка присутствия элемента СвУведСторон">
																	<sch:rule context="СвГруз">
																		<sch:assert test="usch:iif(@ПрУведСторон=1, count(СвУведСторон)!=0, count(СвУведСторон)=0)">
																			<usch:error code="0400300003">Не выполнено условие - Элемент СвУведСторон обязателен и формируется только при значении элемента ПрУведСторон, равном "1".</usch:error>
																		</sch:assert>
																	</sch:rule>
																</sch:pattern>
															</xs:appinfo>
															<!---*************************************************************************************************************************************************************-->
															<xs:documentation>Сведения об уведомлении сторон о прибытии груза в пункт назначения</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="ИноеУвед" type="УчастникТип" minOccurs="0">
																	<xs:annotation>
																		<!---************************************************************************************************************************************************************-->
																		<xs:appinfo>
																			<sch:pattern name="Проверка присутствия элемента ИноеУвед">
																				<sch:rule context="СвУведСторон">
																					<sch:assert test="usch:iif(@Сторона=3, count(ИноеУвед)!=0, count(ИноеУвед)=0)">
																						<usch:error code="0400300003">Не выполнено условие - Элемент ИноеУвед обязателен и формируется только при значении элемента Сторона, равном "3".</usch:error>
																					</sch:assert>
																				</sch:rule>
																			</sch:pattern>
																		</xs:appinfo>
																		<!---*************************************************************************************************************************************************************-->
																		<xs:documentation>Иное лицо, которое необходимо уведомить о прибытии груза</xs:documentation>
																	</xs:annotation>
																</xs:element>
															</xs:sequence>
															<xs:attribute name="Сторона" use="required">
																<xs:annotation>
																	<xs:documentation>Сторона транспортной экспедиции, которую необходимо уведомить о прибытии груза</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:length value="1"/>
																		<xs:enumeration value="1"/>
																		<xs:enumeration value="2"/>
																		<xs:enumeration value="3"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="СпосУвед" use="optional">
																<xs:annotation>
																	<xs:documentation>Способ уведомления о прибытии груза</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="1000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
													<xs:element name="СвГП" type="УчастникТип">
														<xs:annotation>
															<xs:documentation>Сведения о грузополучателе</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="СвГО" type="УчастникТип">
														<xs:annotation>
															<xs:documentation>Сведения о грузоотправителе</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="СвТС" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Сведения о транспорте</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:attribute name="ВидТС" use="required">
																<xs:annotation>
																	<xs:documentation>Вид транспорта</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:length value="1"/>
																		<xs:enumeration value="1"/>
																		<xs:enumeration value="2"/>
																		<xs:enumeration value="3"/>
																		<xs:enumeration value="4"/>
																		<xs:enumeration value="5"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ТипКузов" use="optional">
																<xs:annotation>
																	<!---************************************************************************************************************************************************************-->
																	<xs:appinfo>
																		<sch:pattern name="Проверка присутствия элемента ТипКузов">
																			<sch:rule context="СвТС">
																				<sch:assert test="usch:iif(@ВидТС=1 or @ВидТС=4, count(@ТипКузов)=0 or count(@ТипКузов)!=0, count(@ТипКузов)=0)">
																					<usch:error code="0400300003">Не выполнено условие - Элемент ТипКузов формируется только при значении элемента ВидТС, равном "1" или "4".</usch:error>
																				</sch:assert>
																			</sch:rule>
																		</sch:pattern>
																	</xs:appinfo>
																	<!---*************************************************************************************************************************************************************-->
																	<xs:documentation>Требования к типу кузова/прицепа(полуприцепа)/вагона</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="1000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
													<xs:element name="УказКлнт" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Сведения об указании клиентом особых условий перевозки</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="КлимРеж" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Климатический режим перевозки</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:attribute name="ТемпНеНиже" use="optional">
																			<xs:annotation>
																				<xs:documentation>Нижний предел температуры, градусов Цельсия (от)</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:decimal">
																					<xs:totalDigits value="6"/>
																					<xs:fractionDigits value="2"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="ТемпНеВыше" use="optional">
																			<xs:annotation>
																				<xs:documentation>Верхний предел температуры, градусов Цельсия (до)</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:decimal">
																					<xs:totalDigits value="6"/>
																					<xs:fractionDigits value="2"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="ВлажнНеНиже" use="optional">
																			<xs:annotation>
																				<xs:documentation>Нижний предел влажности, процент (от)</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:decimal">
																					<xs:totalDigits value="5"/>
																					<xs:fractionDigits value="2"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="ВлажнНеВыше" use="optional">
																			<xs:annotation>
																				<xs:documentation>Верхний предел влажности, процент (до)</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:decimal">
																					<xs:totalDigits value="5"/>
																					<xs:fractionDigits value="2"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																	</xs:complexType>
																</xs:element>
																<xs:element name="ИнфПол" type="ИнфПолТип" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Информационное поле</xs:documentation>
																	</xs:annotation>
																</xs:element>
															</xs:sequence>
															<xs:attribute name="СрокДостГр" use="optional">
																<xs:annotation>
																	<xs:documentation>Срок доставки груза, в сутках</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:integer">
																		<xs:totalDigits value="3"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="УкНормПрвз" use="required">
																<xs:annotation>
																	<xs:documentation>Указания в отношении выполнения норм перевозки (для выполнения фитосанитарных, санитарных, карантинных, таможенных и прочих требований, установленных законодательством Российской Федерации)</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="2000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ОгрСкор" use="optional">
																<xs:annotation>
																	<xs:documentation>Указания об ограничениях скорости движения при перевозке груза</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="2000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="Отмет" use="required">
																<xs:annotation>
																	<xs:documentation>Особые отметки</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="2000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
													<xs:element name="ВесГрузПарт" type="ВесТип" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Вес партии груза</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:choice>
														<xs:element name="ОбъявлСтГрузПарт" type="СтГрузТип" minOccurs="0">
															<xs:annotation>
																<xs:documentation>Объявленная стоимость партии груза</xs:documentation>
															</xs:annotation>
														</xs:element>
														<xs:element name="ДейстСтГрузПарт" type="СтГрузТип" minOccurs="0">
															<xs:annotation>
																<xs:documentation>Действительная стоимость партии груза</xs:documentation>
															</xs:annotation>
														</xs:element>
													</xs:choice>
													<xs:element name="ОпГруз" maxOccurs="unbounded">
														<xs:annotation>
															<!---** Условие ****************************************************************************************************************************************-->
															<xs:appinfo>
																<sch:pattern name="Проверка присутствие элемента НомКонтейн">
																	<sch:rule context="ОпГруз">
																		<sch:assert test="usch:iif(../@ПрзПрвз=1 or ../@ПрзПрвз=2 , count(НомКонтейн)!=0 or count(НомКонтейн)=0, count(НомКонтейн)=0)">
																			<usch:error code="0400300003" path="НомКонтейн" value-of-select="count(НомКонтейн)">Не выполнено условие - элемент НомКонтейн формируется только при значении элемента ПрзПрвз, равном "1" или "2".</usch:error>
																		</sch:assert>
																	</sch:rule>
																</sch:pattern>
															</xs:appinfo>
															<!---***************************************************************************************************************************************************-->
															<xs:documentation>Описание груза</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="КодТовОКПД2" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Код товара по ОКПД 2</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:minLength value="2"/>
																			<xs:maxLength value="12"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="КодГрузГНГ" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Код гармонизированной номенклатуры груза (ГНГ)</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:minLength value="1"/>
																			<xs:maxLength value="8"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="КодГрузЕТСНГ" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Код единой тарифно-статистической номенклатуры груза (ЕТСНГ)</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:minLength value="1"/>
																			<xs:maxLength value="6"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="Марк" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Маркировка груза</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:string">
																			<xs:minLength value="1"/>
																			<xs:maxLength value="1000"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="НомКонтейн" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Порядковый номер контейнера</xs:documentation>
																	</xs:annotation>
																	<xs:simpleType>
																		<xs:restriction base="xs:integer">
																			<xs:totalDigits value="3"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="СвСтрПроисх" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Сведения о стране происхождения груза</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:attribute name="КодСтр" type="ОКСМТип" use="required">
																			<xs:annotation>
																				<xs:documentation>Код страны</xs:documentation>
																			</xs:annotation>
																		</xs:attribute>
																		<xs:attribute name="НаимСтран" use="required">
																			<xs:annotation>
																				<xs:documentation>Наименование страны</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="255"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																	</xs:complexType>
																</xs:element>
																<xs:element name="ВесГруз" type="ВесТип">
																	<xs:annotation>
																		<xs:documentation>Вес груза</xs:documentation>
																	</xs:annotation>
																</xs:element>
