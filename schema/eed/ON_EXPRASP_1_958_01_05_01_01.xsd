																	<xs:documentation>Вес тары контейнера, (кг)</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:decimal">
																		<xs:totalDigits value="18"/>
																		<xs:fractionDigits value="4"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="КолПломб" use="optional">
																<xs:annotation>
																	<xs:documentation>Количество пломб, наложенных на контейнер</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:integer">
																		<xs:totalDigits value="5"/>
																	</xs:restriction>
																</xs:simpleType>
