<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2011 sp1 (http://www.altova.com) by Shakeev (FGUP GNIVC FNS Russia) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:usch="http://www.unisoftware.ru/schematron-extensions" xmlns:sql="urn:schemas-microsoft-com:mapping-schema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="Файл">
		<xs:annotation>
			<!---******************************************************************************************************************************************************************************-->
			<xs:appinfo>
				<sch:pattern name="Проверка имени файла на соответствие значению атрибута @ИдФайл">
					<sch:rule context="Файл">
						<!-- 1. Проверка имени файла на соответствие ИдФайл -->
						<sch:assert test="usch:getFileName() = @ИдФайл">
							<usch:error code="0400400007" path="@ИдФайл" value-of-select="@ИдФайл" doc-id-path="usch:getFileName()" doc-id-caption="Файл">Имя файла обмена "<usch:value-of select="usch:getFileName()"/>" не совпадает со значением элемента ИдФайл "<usch:value-of select="@ИдФайл"/>"</usch:error>
						</sch:assert>
					</sch:rule>
				</sch:pattern>
			</xs:appinfo>
			<!---******************************************************************************************************************************************************************************-->
			<xs:documentation>Файл обмена</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ИдПолИной" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Идентификатор иного получателя файла обмена информации экспедитора</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="4"/>
							<xs:maxLength value="46"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Документ">
					<xs:annotation>
						<xs:documentation>Электронное поручение экспедитору, информация экспедитора</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ИдИнфКлнт">
								<xs:annotation>
									<xs:documentation>Идентификация файла обмена информации клиента</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ЭП" maxOccurs="1">
											<xs:annotation>
												<xs:documentation>Электронная подпись файла обмена информации клиента</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="ИдФайлИнфКлнт" use="required">
										<xs:annotation>
											<xs:documentation>Идентификатор файла обмена информации о клиента</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:minLength value="1"/>
												<xs:maxLength value="255"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="ДатФайлИнфКлнт" type="ДатаТип" use="required">
										<xs:annotation>
											<xs:documentation>Дата формирования файла обмена информации клиента</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="ВрФайлИнфКлнт" type="ВремяТип" use="required">
										<xs:annotation>
											<xs:documentation>Время формирования файла обмена информации клиента</xs:documentation>
										</xs:annotation>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
							<xs:element name="СодИнфЭксп">
								<xs:annotation>
									<xs:documentation>Содержание электронного поручения экспедитору, информация экспедитора</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="ИныеДанЭксп" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Иные данные и оговорки экспедитора</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:string">
													<xs:minLength value="1"/>
													<xs:maxLength value="2000"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="ДопИнфЭксп" minOccurs="0" maxOccurs="unbounded">
											<xs:annotation>
												<xs:documentation>Дополнительная информация экспедитора по согласованным и подлежащим оказанию транспортно-экспедиционным услугам</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="ИдентПартГруз" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Идентификатор партии груза</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:length value="36"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="НомПартГруз" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Порядковый номер партии груза</xs:documentation>
														</xs:annotation>
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:minLength value="1"/>
																<xs:maxLength value="255"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="СвПредстЭксп" minOccurs="0">
														<xs:annotation>
															<!---************************************************************************************************************************************************************-->
															<xs:appinfo>
																<sch:pattern name="Проверка присутствия элемента СвПредстЭксп">
																	<sch:rule context="ДопИнфЭксп">
																		<sch:assert test="usch:iif(@ПризнИсп=2 or @ПризнИсп=3, count(СвПредстЭксп)!=0 or count(СвПредстЭксп)=0, count(СвПредстЭксп)=0)">
																			<usch:error code="0400300003">Не выполнено условие - Элемент СвПредстЭксп формируется только при значении элемента ПризнИсп, равном "2" или "3".</usch:error>
																		</sch:assert>
																	</sch:rule>
																</sch:pattern>
															</xs:appinfo>
															<!---*************************************************************************************************************************************************************-->
															<xs:documentation>Сведения о третьем лице, привлеченным экспедитором для оказания услуг, связанных с организацией перевозки груза</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="РекИдПредст" type="УчастникТип">
																	<xs:annotation>
																		<xs:documentation>Реквизиты, позволяющие идентифицировать третье лицо, привлеченное экспедитором</xs:documentation>
																	</xs:annotation>
																</xs:element>
																<xs:element name="ОснОкУслИным" type="РеквДокТип" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Реквизиты документа, определяющего основания для оказания иных услуг, связанных с организацией перевозки груза иным лицом, отличным от экспедитора</xs:documentation>
																	</xs:annotation>
																</xs:element>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
													<xs:element name="СвОплата" minOccurs="0">
														<xs:annotation>
															<xs:documentation>Сведения об оплате услуг транспортной экспедиции</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="СумНал" type="СумНДСТип" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Сумма налога</xs:documentation>
																	</xs:annotation>
																</xs:element>
																<xs:element name="ДокОплУсл" type="РеквДокТип" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Документ, согласно которому производится оплата услуг транспортной экспедиции</xs:documentation>
																	</xs:annotation>
																</xs:element>
															</xs:sequence>
															<xs:attribute name="ОбщСтУсл" use="required">
																<xs:annotation>
																	<xs:documentation>Стоимость услуги транспортной экспедиции</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:decimal">
																		<xs:totalDigits value="18"/>
																		<xs:fractionDigits value="2"/>
																		<xs:minInclusive value="0"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="НалСт" use="required">
																<xs:annotation>
																	<xs:documentation>Ставка налога</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="35"/>
																		<xs:enumeration value="0%"/>
																		<xs:enumeration value="5%"/>
																		<xs:enumeration value="7%"/>
																		<xs:enumeration value="22%"/>
																		<xs:enumeration value="без НДС"/>
																		<xs:enumeration value="НДС исчисляется налоговым агентом"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="КодОКВ" type="ОКВТип" use="required">
																<xs:annotation>
																	<xs:documentation>Валюта стоимости: код</xs:documentation>
																</xs:annotation>
															</xs:attribute>
															<xs:attribute name="НаимОКВ" use="required">
																<xs:annotation>
																	<xs:documentation>Валюта стоимости: наименование</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="100"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
													<xs:element name="СвТрсГруз" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Сведения о транспортировке груза</xs:documentation>
														</xs:annotation>
														<xs:complexType>
															<xs:sequence>
																<xs:element name="СвТСДост" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<!---************************************************************************************************************************************************************-->
																		<xs:appinfo>
																			<sch:pattern name="Проверка присутствия элемента ТипКузов, РегНомер, Марка, Модель, СвВодит">
																				<sch:rule context="СвТСДост">
																					<sch:assert test="usch:iif(@ВидТС=1 or @ВидТС=4, count(@ТипКузов)=0 or count(@ТипКузов)!=0, count(@ТипКузов)=0)">
																						<usch:error code="0400300003">Не выполнено условие - Элемент ТипКузов формируется только при значении элемента  ВидТС, равном "1" ил "4".</usch:error>
																					</sch:assert>
																					<sch:assert test="usch:iif(@ВидТС!=1 , count(@РегНомер)=0 , count(@РегНомер)=0 or count(@РегНомер)!=0)">
																						<usch:error code="0400300003">Не выполнено условие - Элемент РегНомер формируется только при значении элемента  ВидТС, равном "1".</usch:error>
																					</sch:assert>
																					<sch:assert test="usch:iif(@ВидТС!=1 , count(@Марка)=0 , count(@Марка)=0 or count(@Марка)!=0)">
																						<usch:error code="0400300003">Не выполнено условие - Элемент Марка формируется только при значении элемента  ВидТС, равном "1".</usch:error>
																					</sch:assert>
																					<sch:assert test="usch:iif(@ВидТС!=1 , count(@Модель)=0 , count(@Модель)=0 or count(@Модель)!=0)">
																						<usch:error code="0400300003">Не выполнено условие - Элемент Модель формируется только при значении элемента  ВидТС, равном "1".</usch:error>
																					</sch:assert>
																					<sch:assert test="usch:iif(@ВидТС!=1 , count(СвВодит)=0 , count(СвВодит)=0 or count(СвВодит)!=0)">
																						<usch:error code="0400300003">Не выполнено условие - Элемент СвВодит формируется только при значении элемента  ВидТС, равном "1".</usch:error>
																					</sch:assert>
																				</sch:rule>
																			</sch:pattern>
																		</xs:appinfo>
																		<!---*************************************************************************************************************************************************************-->
																		<xs:documentation>Сведения о транспортном средстве, на котором будет осуществлена доставка груза</xs:documentation>
																	</xs:annotation>
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="СвВодит" minOccurs="0" maxOccurs="unbounded">
																				<xs:annotation>
																					<!---************************************************************************************************************************************************************-->
																					<xs:appinfo>
																						<sch:pattern name="Проверка присутствия элемента НомВУ, СерВУ, ДатаВыдВУ, ИННФЛ">
																							<sch:rule context="СвВодит">
																								<sch:assert test="(count(@НомВУ)!=0 and count(@СерВУ)!=0 and count(@ДатаВыдВУ)!=0) or count(@ИННФЛ)!=0">
																									<usch:error code="0400300001">Не выполнено условие - Элементы НомВУ, СерВУ и ДатаВыдВУ обязательны при отсутствии элемента ИННФЛ или элемент ИННФЛ обязатален при отсутствии элементов НомВУ, СерВУ и ДатаВыдВУ.</usch:error>
																								</sch:assert>
																							</sch:rule>
																						</sch:pattern>
																					</xs:appinfo>
																					<!---*************************************************************************************************************************************************************-->
																					<xs:documentation>Сведения о водителе (водителях)</xs:documentation>
																				</xs:annotation>
																				<xs:complexType>
																					<xs:sequence>
																						<xs:element name="Тлф" maxOccurs="unbounded">
																							<xs:annotation>
																								<xs:documentation>Номер телефона</xs:documentation>
																							</xs:annotation>
																							<xs:simpleType>
																								<xs:restriction base="xs:string">
																									<xs:minLength value="1"/>
																									<xs:maxLength value="20"/>
																								</xs:restriction>
																							</xs:simpleType>
																						</xs:element>
																						<xs:element name="ФИО" type="ФИОТип">
																							<xs:annotation>
																								<xs:documentation>Фамилия, имя, отчество (при наличии)</xs:documentation>
																							</xs:annotation>
																						</xs:element>
																						<xs:element name="ПутевойЛист" type="РеквДокТип" minOccurs="0">
																							<xs:annotation>
																								<xs:documentation>Сведения о путевом листе</xs:documentation>
																							</xs:annotation>
																						</xs:element>
																					</xs:sequence>
																					<xs:attribute name="НомВУ" use="optional">
																						<xs:annotation>
																							<xs:documentation>Номер водительского удостоверения</xs:documentation>
																						</xs:annotation>
																						<xs:simpleType>
																							<xs:restriction base="xs:string">
																								<xs:minLength value="1"/>
																								<xs:maxLength value="20"/>
																							</xs:restriction>
																						</xs:simpleType>
																					</xs:attribute>
																					<xs:attribute name="СерВУ" use="optional">
																						<xs:annotation>
																							<xs:documentation>Серия водительского удостоверения</xs:documentation>
																						</xs:annotation>
																						<xs:simpleType>
																							<xs:restriction base="xs:string">
																								<xs:minLength value="1"/>
																								<xs:maxLength value="20"/>
																							</xs:restriction>
																						</xs:simpleType>
																					</xs:attribute>
																					<xs:attribute name="ДатаВыдВУ" type="ДатаТип" use="optional">
																						<xs:annotation>
																							<xs:documentation>Дата выдачи водительского удостоверения</xs:documentation>
																						</xs:annotation>
																					</xs:attribute>
																					<xs:attribute name="ИННФЛ" type="ИННФЛТип" use="optional">
																						<xs:annotation>
																							<xs:documentation>ИНН физического лица</xs:documentation>
																						</xs:annotation>
																					</xs:attribute>
																					<xs:attribute name="СвСпИдПодп" use="optional">
																						<xs:annotation>
																							<xs:documentation>Сведения о способе идентификации при применении простой электронной подписи</xs:documentation>
																						</xs:annotation>
																						<xs:simpleType>
																							<xs:restriction base="xs:string">
																								<xs:minLength value="1"/>
																								<xs:maxLength value="1000"/>
																							</xs:restriction>
																						</xs:simpleType>
																					</xs:attribute>
																				</xs:complexType>
																			</xs:element>
																		</xs:sequence>
																		<xs:attribute name="ВидТС" use="required">
																			<xs:annotation>
																				<xs:documentation>Вид транспорта</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:length value="1"/>
																					<xs:enumeration value="1"/>
																					<xs:enumeration value="2"/>
																					<xs:enumeration value="3"/>
																					<xs:enumeration value="4"/>
																					<xs:enumeration value="5"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="ТипКузов" use="optional">
																			<xs:annotation>
																				<xs:documentation>Тип кузова/прицепа(полуприцепа)/вагона</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="1000"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="РегНомер" use="optional">
																			<xs:annotation>
																				<xs:documentation>Государственный регистрационный номер транспортного средства</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="20"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="Марка" use="optional">
																			<xs:annotation>
																				<xs:documentation>Марка</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="255"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																		<xs:attribute name="Модель" use="optional">
																			<xs:annotation>
																				<xs:documentation>Модель</xs:documentation>
																			</xs:annotation>
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:minLength value="1"/>
																					<xs:maxLength value="255"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:attribute>
																	</xs:complexType>
																</xs:element>
															</xs:sequence>
															<xs:attribute name="МаршСлГруз" use="required">
																<xs:annotation>
																	<xs:documentation>Маршрут следования груза</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:string">
																		<xs:minLength value="1"/>
																		<xs:maxLength value="1000"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
														</xs:complexType>
													</xs:element>
													<xs:element name="РеквЗакПост" type="РеквДокТип" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Реквизиты заказа на поставку</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="ИнфПол" type="ИнфПолТип" minOccurs="0" maxOccurs="unbounded">
														<xs:annotation>
															<xs:documentation>Информационное поле</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="ПризнИсп" use="required">
													<xs:annotation>
														<xs:documentation>Признак исполнения экспедитором своих обязанностей</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:string">
