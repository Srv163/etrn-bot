																			<xs:documentation>Идентификационный номер контейнера (нестандартый)</xs:documentation>
																		</xs:annotation>
																		<xs:simpleType>
																			<xs:restriction base="xs:string">
																				<xs:minLength value="1"/>
																				<xs:maxLength value="255"/>
																			</xs:restriction>
																		</xs:simpleType>
																	</xs:element>
																</xs:choice>
																<xs:element name="ГабарСпКонтейн" type="ГабаритТип" minOccurs="0">
																	<xs:annotation>
																		<xs:documentation>Габариты специального контейнера, в метрах</xs:documentation>
																	</xs:annotation>
																</xs:element>
																<xs:element name="ИнфПол" type="ИнфПолТип" minOccurs="0" maxOccurs="unbounded">
																	<xs:annotation>
																		<xs:documentation>Информационное поле</xs:documentation>
																	</xs:annotation>
																</xs:element>
															</xs:sequence>
															<xs:attribute name="НомКонтейн" use="required">
																<xs:annotation>
																	<xs:documentation>Порядковый номер контейнера</xs:documentation>
																</xs:annotation>
																<xs:simpleType>
																	<xs:restriction base="xs:integer">
																		<xs:totalDigits value="3"/>
																	</xs:restriction>
																</xs:simpleType>
															</xs:attribute>
															<xs:attribute name="ИСОКонтейн" use="optional">
