												</xs:attribute>
											</xs:complexType>
										</xs:element>
										<xs:element name="АдрПриемГруз" type="АдресПользТип" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Адрес приема груза</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="СвКлнт" type="УчастникТип">
